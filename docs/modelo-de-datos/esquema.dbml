// Esquema del modelo de datos del sistema de inventario.
// Es la fuente del modelo: los documentos de esta carpeta lo explican.
// Para verlo como diagrama, pegar este archivo en https://dbdiagram.io

Project sistema_logistico_emergencias {
  Note: 'Sistema de inventario de un centro de acopio. Una instalación, un centro. Ver docs/modelo-de-datos/README.md'
}

// ---------- Centro ----------

Table centro {
  id uuid [pk, note: 'UUIDv7. Se genera al instalar.']
  nombre varchar [not null, note: 'No es único: puede haber dos centros con el mismo nombre.']
  tipo tipo_centro [not null]
  organizacion varchar [note: 'Quién opera el centro. En la segunda etapa podrá ser una tabla propia.']
  responsable_id uuid [not null, ref: > usuario.id, note: 'Contacto principal. Debe ser un coordinador.']
  pais varchar(2) [not null, default: 'VE', note: 'ISO 3166-1. Siempre VE por ahora.']
  entidad_federal entidad_federal [not null, note: 'Código ISO 3166-2.']
  municipio varchar [not null, note: 'Texto libre por ahora.']
  parroquia varchar
  direccion varchar
  punto_referencia varchar [note: 'Ej.: frente a la panadería La Esquina.']
  telefono varchar [note: 'Formato internacional: +582121234567.']
  situacion situacion_centro [not null, default: 'activo', note: 'Un centro nunca se borra: se cierra.']
  creado_en timestamp [not null, note: 'UTC.']
  actualizado_en timestamp [not null, note: 'UTC.']

  Note: 'El centro de acopio que usa esta instalación. Hay uno por instalación.'
}

// Lista provisional, a confirmar en las entrevistas.
Enum tipo_centro {
  centro_de_acopio
  albergue
  punto_de_distribucion
  otro
}

Enum situacion_centro {
  activo
  en_pausa
  cerrado
}

// ISO 3166-2:VE: 23 estados, el Distrito Capital y las Dependencias Federales.
Enum entidad_federal {
  "VE-A" [note: 'Distrito Capital']
  "VE-B" [note: 'Anzoátegui']
  "VE-C" [note: 'Apure']
  "VE-D" [note: 'Aragua']
  "VE-E" [note: 'Barinas']
  "VE-F" [note: 'Bolívar']
  "VE-G" [note: 'Carabobo']
  "VE-H" [note: 'Cojedes']
  "VE-I" [note: 'Falcón']
  "VE-J" [note: 'Guárico']
  "VE-K" [note: 'Lara']
  "VE-L" [note: 'Mérida']
  "VE-M" [note: 'Miranda']
  "VE-N" [note: 'Monagas']
  "VE-O" [note: 'Nueva Esparta']
  "VE-P" [note: 'Portuguesa']
  "VE-R" [note: 'Sucre']
  "VE-S" [note: 'Táchira']
  "VE-T" [note: 'Trujillo']
  "VE-U" [note: 'Yaracuy']
  "VE-V" [note: 'Zulia']
  "VE-W" [note: 'Dependencias Federales']
  "VE-X" [note: 'La Guaira']
  "VE-Y" [note: 'Delta Amacuro']
  "VE-Z" [note: 'Amazonas']
}

// ---------- Acceso (ADR-0003) ----------

Table usuario {
  id uuid [pk, note: 'UUIDv7.']
  nombre_completo varchar [not null]
  telefono varchar [not null, unique, note: 'Con él entra al sistema. Formato internacional: +584141234567.']
  correo varchar [unique, note: 'Opcional. Solo dato de contacto.']
  rol rol_usuario [not null]
  credencial_hash varchar [not null, note: 'PIN o contraseña con Argon2id. Nunca se guarda tal cual.']
  requiere_cambio boolean [not null, default: false, note: 'Debe elegir un PIN o una contraseña nuevos al entrar.']
  situacion situacion_usuario [not null, default: 'activo', note: 'Un usuario nunca se borra: se desactiva.']
  intentos_fallidos int [not null, default: 0]
  bloqueado_hasta timestamp [note: 'UTC. Si tiene valor, no puede entrar hasta esa hora.']
  ultimo_acceso timestamp [note: 'UTC.']
  creado_en timestamp [not null, note: 'UTC.']
  actualizado_en timestamp [not null, note: 'UTC.']

  Note: 'Cada persona que usa el sistema del centro: voluntarios y coordinadores.'
}

Enum rol_usuario {
  voluntario
  coordinador
}

Enum situacion_usuario {
  activo
  desactivado
}

TableGroup centro_de_acopio {
  centro
}

// Usuarios y acceso (ADR-0003).
TableGroup acceso {
  usuario
}
